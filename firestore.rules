rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Data Validation ==========
    function isValidAchievement() {
      return request.resource.data.keys().hasAll(['title', 'desc', 'teacherName', 'date'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.desc is string
        && request.resource.data.desc.size() <= 2000;
    }

    // ========== Achievements Collection ==========
    match /achievements/{achievementId} {
      allow read: if true;
      // All writes are handled server-side via Next.js API routes
      // which verify admin session cookie or achievement PIN.
      // Direct client-side writes are denied for security.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ========== Settings Collection ==========
    match /settings/{settingId} {
      allow read: if true;
      // Settings writes are handled server-side via /api/settings
      // which verifies admin session cookie.
      allow write: if false;
    }

    // ========== Default Deny ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
