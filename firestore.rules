rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Achievements Collection ==========
    match /achievements/{achievementId} {
      allow read: if true;
      // All writes are handled server-side via Next.js API routes
      // which verify admin session cookie or achievement PIN.
      // Direct client-side writes are denied for security.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ========== Settings Collection ==========
    match /settings/{settingId} {
      allow read: if true;
      // Settings writes are handled server-side via /api/settings
      // which verifies admin session cookie.
      allow write: if false;
    }

    // ========== Admin Collection (PIN hashes, etc.) ==========
    match /admin/{document} {
      // Admin data is only accessible server-side via API routes.
      // Direct client-side access is denied.
      allow read: if false;
      allow write: if false;
    }

    // ========== Default Deny ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
