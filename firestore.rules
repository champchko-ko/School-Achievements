rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Data Validation ==========
    function isValidAchievement() {
      return request.resource.data.keys().hasAll(['title', 'desc', 'teacherName', 'date'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.desc is string
        && request.resource.data.desc.size() <= 2000;
    }

    function isValidSettings() {
      return request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() <= 200;
    }

    // ========== Achievements Collection ==========
    match /achievements/{achievementId} {
      allow read: if true;
      // Writes are open because the app uses PIN-based admin auth (client-side).
      // Data validation prevents malformed documents.
      // Upgrade: Add Firebase Auth + change to "allow write: if request.auth != null"
      allow create: if isValidAchievement();
      allow update: if true;
      allow delete: if true;
    }

    // ========== Settings Collection ==========
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidSettings();
    }

    // ========== Default Deny ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
