# ==============================================================================
# Environment Configuration for School-Achievements
# Copy this file to .env.local for local development.
# Configure these variables in Vercel / Production deployment settings.
# ==============================================================================

# Session & JWT Secret (Required)
# Must be at least 32 characters long.
# Generate via: openssl rand -hex 32
AUTH_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing

# PIN Pepper for PBKDF2 hashing (Required)
# Used as static salt component for teacher achievement PINs and admin PIN.
PIN_PEPPER=replace-with-a-random-salt-string-for-pin-hashing

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — distributed rate limiting (Finding #10, Recommended for production)
# From the Upstash console → your database → "REST API" section.
# When unset, the app falls back to per-instance in-memory limits and logs a
# high-severity alert in production (weaker across serverless instances).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Cloudinary Storage (Server-side & client configuration)
# CLOUDINARY_UPLOAD_PRESET must be configured as a "Signed" preset in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_signed_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Client SDK (Public configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase App Check — reCAPTCHA Enterprise site key (Finding #8)
# Only the PUBLIC site key is needed here; never put the reCAPTCHA secret key in the app.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key
# Must match the provider chosen in Firebase Console → App Check: "enterprise" (recommended) or "v3"
NEXT_PUBLIC_APPCHECK_PROVIDER=enterprise

# Firebase Admin SDK (Server-side service account - Required for production)
# Single JSON string OR base64-encoded string of your service account credentials:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your_project_id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"your_service_account@your_project.iam.gserviceaccount.com"}'

# SMTP Configuration (Required for admin PIN reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_admin_email@example.com
SMTP_PASS=your_smtp_app_password

# Cron Job Secret (Required for scheduled backups)
CRON_SECRET=replace-with-a-secret-string-for-vercel-cron
