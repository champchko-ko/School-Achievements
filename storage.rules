rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Restrict writes to authenticated admin users
    // Note: This requires Firebase Auth to be active.
    // For now, writes are open (since the app uses PIN-based admin).
    // Upgrade: change to "allow write: if request.auth != null"
    match /{allPaths=**} {
      allow write: if true;
    }
  }
}
