rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Writes are denied — the app uploads files to Cloudinary, not Firebase Storage.
    // Direct client-side writes to Firebase Storage are blocked for security.
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
