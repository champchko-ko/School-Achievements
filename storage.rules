rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // All application media is uploaded to and served from Cloudinary, not Firebase Storage.
    // Deny unauthenticated reads and always deny writes (Finding #9).
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
